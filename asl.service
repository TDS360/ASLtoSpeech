# Auto-starts the ASL translator on boot and restarts it if it crashes --
# useful at a demo booth if the Pi loses power and reboots unattended.
#
# INSTALL (on the Pi):
#   1. Edit the two paths below (WorkingDirectory / ExecStart) if your
#      project isn't at /home/pi/ASLtoSpeech, and edit "User=" if your
#      Pi's username isn't "pi".
#   2. sudo cp asl.service /etc/systemd/system/asl.service
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable asl.service   # start automatically on boot
#   5. sudo systemctl start asl.service    # start it right now, to test
#
# USEFUL COMMANDS:
#   sudo systemctl status asl.service      # is it running?
#   sudo journalctl -u asl.service -f      # live logs (this is where the
#                                             translator's log.info/debug
#                                             output ends up when headless)
#   sudo systemctl stop asl.service        # stop it
#   sudo systemctl disable asl.service     # stop auto-starting on boot
#
# NOTE: if you're running with "headless": false in config.json, systemd
# services don't have a graphical display to open a window on, so keep
# headless set to true when running this way.

[Unit]
Description=ASL to Speech Translator
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ASLtoSpeech/src
ExecStart=/usr/bin/python3 /home/pi/ASLtoSpeech/src/translator.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
